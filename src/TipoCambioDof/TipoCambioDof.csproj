<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TipoCambioDof</AssemblyName>
    <RootNamespace>TipoCambioDof</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Datos/Esquema.sql" LogicalName="Esquema.sql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TipoCambioDof.Tests" />
  </ItemGroup>

</Project>
