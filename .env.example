# Copiar a .env (no se versiona) y llenar. Lo usan docker-compose.yml (local) y docker-compose.prod.yml (producción).
BANXICO_TOKEN=
# Desde el contenedor, "localhost" es el propio contenedor: si SQL Server corre en tu máquina usa host.docker.internal.
SQL_CONNECTION_STRING=Server=<servidor>,1433;Database=<base>;User Id=<usuario>;Password=<clave>;Encrypt=True;TrustServerCertificate=True
ALERT_WEBHOOK_URL=
# Sistemas legados (SPEC 01). Con true, BD_METRICS y BD_LITO son obligatorias.
ACTUALIZAR_LEGADOS=false
BD_METRICS=MetricsBETA
BD_LITO=Lito_jess
