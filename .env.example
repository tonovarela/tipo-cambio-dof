# Copiar a .env (no se versiona) y llenar. Lo usa docker-compose.yml.
BANXICO_TOKEN=
# Desde el contenedor, "localhost" es el propio contenedor: si SQL Server corre en tu máquina usa host.docker.internal.
SQL_CONNECTION_STRING=Server=<servidor>,1433;Database=<base>;User Id=<usuario>;Password=<clave>;Encrypt=True;TrustServerCertificate=True
ALERT_WEBHOOK_URL=
